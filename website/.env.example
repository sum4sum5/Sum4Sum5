# Safe template: ONLY placeholders. Never paste production API keys, passwords, or
# long-lived secrets into this file — it is committed to Git. Real values belong
# in `.env.local` (gitignored) or in your host’s env (e.g. Vercel).
# If any secret is ever committed or leaked, rotate it (new keys/passwords) immediately.
#
# Local dev: `cp .env.example .env.local` then fill `.env.local`.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_TABLE_NAME=usage_stats
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI Configuration (server-only secret)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model
GEMINI_API_VERSION=your_api_version
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=1024
GEMINI_SLANG_YEAR=2026
GEMINI_HASHTAG_COUNT=5
GEMINI_VARIANT_COUNT=3
GEMINI_VARIANT_DESCS=กวนๆ, โดนใจ, ขายของ
# Phase 2 guards
# Local/dev defaults (production should be stricter)
GEMINI_RATE_LIMIT_WINDOW_MS=60000
GEMINI_RATE_LIMIT_MAX_REQUESTS=8
GEMINI_TIMEOUT_MS=15000

# Admin (server-only; passwords live in Supabase `admin_users` as bcrypt—never commit real passwords)
# After applying supabase/migrations/* for admin_users, run once: npm run admin:seed
# SEED_ADMIN_USERNAME=admin   (same value as in DB / what you type at /admin, case-sensitive)
# SEED_ADMIN_PASSWORD=use_a_long_random_password_for_seed_script_only
ADMIN_SESSION_SECRET=your_random_session_secret

# NOTE:
# - Do not use NEXT_PUBLIC_* for any admin or service secret.
# - Admin login: username + password; remove SEED_* from Vercel after you create the first user.
